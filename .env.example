# LinkedIn Credentials
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_password_here

# Job Search Settings
JOB_KEYWORDS=Software Engineer,Backend Developer,Full Stack Developer
JOB_LOCATION=United States
EXPERIENCE_LEVEL=entry_level,associate,mid_senior
REMOTE_FILTER=remote,hybrid

# Referral Outreach Settings
MAX_MESSAGES_PER_DAY=20
MESSAGE_DELAY_MIN=60
MESSAGE_DELAY_MAX=180

# Schedule (24hr format)
DAILY_RUN_HOUR=9
DAILY_RUN_MINUTE=0

# Browser Settings
HEADLESS=false
CHROME_PROFILE_PATH=

# Database
DB_PATH=./data/jobs.db

# Logging
LOG_LEVEL=INFO
