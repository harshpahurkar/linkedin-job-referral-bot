# LinkedIn Credentials
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_password_here

# Job Search Settings
JOB_KEYWORDS=Software Engineer,Backend Developer,Full Stack Developer
JOB_LOCATION=Canada
EXPERIENCE_LEVEL=entry_level,associate
REMOTE_FILTER=remote,hybrid,on_site
JOB_POSTED_WITHIN=r604800

# Referral Outreach Settings
DAILY_TARGET_MIN=25
DAILY_TARGET_MAX=40
MAX_MESSAGES_PER_COMPANY=3
MESSAGE_DELAY_MIN=20
MESSAGE_DELAY_MAX=50
MAX_CONNECTIONS_PER_WEEK=200
MAX_PROFILE_VIEWS_PER_WEEK=800

# Schedule (24hr format)
DAILY_RUN_HOUR=9
DAILY_RUN_MINUTE=0

# Browser Settings
HEADLESS=false
CHROME_PROFILE_PATH=

# Database
DB_PATH=./data/jobs.db

# Logging
LOG_LEVEL=INFO
